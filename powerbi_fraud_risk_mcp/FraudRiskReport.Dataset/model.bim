        "dataCategory": "Time",
        "lineageTag": "b282299c-f75a-41e8-8989-b86fb92fe93a",
        "partitions": [
          {
            "name": "Dim_Date",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "ADDCOLUMNS(",
                "    CALENDAR(DATE(2026, 7, 1), DATE(2026, 10, 31)),",
                "    \"Year\", YEAR([Date]),",
                "    \"Month\", FORMAT([Date], \"MMM YYYY\"),",
                "    \"MonthNum\", MONTH([Date]),",
                "    \"DayOfWeek\", FORMAT([Date], \"ddd\")",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
