            ],
            "dataType": "string",
            "lineageTag": "4fd94777-a541-4e01-a6d5-4be2b2fa8338",
            "sourceColumn": "Column1",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "61160b64-822a-428f-a43e-0d0150736083",
        "measures": [
          {
            "name": "Total GMV",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Core KPIs",
            "expression": "SUM(Fact_Transactions[amount_inr])",
            "formatString": "$#,##0.00",
            "lineageTag": "a7b12732-dfc2-416e-ad9d-68201024b739"
          },
          {
            "name": "Total Fraud Loss",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Core KPIs",
            "expression": [
              "CALCULATE(",
              "    SUM(Fact_Transactions[amount_inr]),",
              "    Fact_Transactions[fraud_flag] = 1",
              ")"
            ],
            "formatString": "$#,##0.00",
            "lineageTag": "550b2bf5-b5c3-409a-97e6-a36f08e67fea"
          },
          {
            "name": "Fraud Loss Rate %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Core KPIs",
            "expression": "DIVIDE([Total Fraud Loss], [Total GMV], 0)",
            "formatString": "0.00%",
            "lineageTag": "e2a5141f-fe18-4cc8-aa9f-195633d77476"
          },
          {
            "name": "Fraud Txn Count",
            "displayFolder": "Core KPIs",
            "expression": "CALCULATE(COUNTROWS(Fact_Transactions), Fact_Transactions[fraud_flag] = 1)",
            "lineageTag": "affc5e00-81aa-46e3-8645-dc215b0fa5dc"
          },
          {
            "name": "MTD Fraud Loss",
            "displayFolder": "Time Intelligence",
            "expression": "TOTALMTD([Total Fraud Loss], Dim_Date[Date])",
            "formatString": "$#,##0.00",
            "lineageTag": "1d0dedfa-83c4-4726-9cf7-198f1cc945d0"
          },
          {
            "name": "Prev Month Fraud Loss",
            "displayFolder": "Time Intelligence",
            "expression": "CALCULATE([Total Fraud Loss], PREVIOUSMONTH(Dim_Date[Date]))",
            "formatString": "$#,##0.00",
            "lineageTag": "f8ca4622-ec31-4244-a6aa-90fec7301eb7"
          },
          {
            "name": "MoM Fraud Loss Change %",
            "displayFolder": "Time Intelligence",
            "expression": "DIVIDE([Total Fraud Loss] - [Prev Month Fraud Loss], [Prev Month Fraud Loss], 0)",
            "formatString": "0.00%",
            "lineageTag": "57b19579-bb85-4887-b31e-6bd0be92b8bd"
          },
          {
            "name": "7-Day Rolling Fraud Loss",
            "displayFolder": "Time Intelligence",
            "expression": "CALCULATE([Total Fraud Loss], DATESINPERIOD(Dim_Date[Date], LASTDATE(Dim_Date[Date]), -7, DAY))",
            "formatString": "$#,##0.00",
            "lineageTag": "dda66384-33e2-48bc-8ed9-3956e084a296"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
